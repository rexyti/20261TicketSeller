# Base de datos (R2DBC)
SPRING_R2DBC_URL=r2dbc:postgresql://<host>:5432/ticketseller
SPRING_R2DBC_USERNAME=
SPRING_R2DBC_PASSWORD=

# Base de datos (PostgreSQL directo — usado por el contenedor db)
POSTGRES_DB=ticketseller
POSTGRES_USER=
POSTGRES_PASSWORD=

# Correo (SMTP)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Servidor
SERVER_PORT=8080

FRONTEND_URL=http://localhost:5173